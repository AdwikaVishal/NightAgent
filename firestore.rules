rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers (Phase 1A security hardening, reconciled with main) ──────────
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function journeyOwner(journeyId) {
      return signedIn()
        && get(/databases/$(database)/documents/journeys/$(journeyId)).data.userId == request.auth.uid;
    }

    function isValidTimeMs(t) {
      return t is number && t > 0;
    }

    function isValidLatLng(lat, lng) {
      return lat is double && lat >= -90.0 && lat <= 90.0
          && lng is double && lng >= -180.0 && lng <= 180.0;
    }

    function isValidLocationUpdate(newDoc) {
      return newDoc.lat is double && newDoc.lat >= -90.0 && newDoc.lat <= 90.0
          && newDoc.lng is double && newDoc.lng >= -180.0 && newDoc.lng <= 180.0
          && newDoc.time is number && newDoc.time > 0
          && newDoc.keys() == ["lat", "lng", "time"];
    }

    function isValidFcmRequest(newDoc) {
      return newDoc.token is string && newDoc.token.size() > 0 && newDoc.token.size() <= 200
          && newDoc.chatId is string && newDoc.chatId.size() > 0
          && newDoc.senderId is string && newDoc.senderId.size() > 0
          && newDoc.senderName is string && newDoc.senderName.size() > 0 && newDoc.senderName.size() <= 100
          && newDoc.timestamp is number && newDoc.timestamp > 0
          && newDoc.keys() == ["token", "chatId", "senderId", "senderName", "timestamp"];
    }

    function senderIsChatParticipant(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId))
          && get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function validParticipants(participants) {
      return participants is list && participants.size() == 2
          && participants.all(p, p is string && p.size() > 0);
    }

    // ── users/{uid} (user profile — Person 6 voice registration + Person 2 guardian contacts) ──
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── chats/{chatId} (guardian/voice chat membership — Person 2 + Person 6) ──
    match /chats/{chatId} {
      allow read: if signedIn()
          && resource.data != null
          && validParticipants(resource.data.participants)
          && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
          && request.resource.data.chatId == chatId
          && validParticipants(request.resource.data.participants)
          && request.auth.uid in request.resource.data.participants
          // Only allowed fields (matches VoiceMessageFirebase.ensureChatRoom).
          && request.resource.data.keys() == ["chatId", "participants", "createdAt"];

      allow update: if signedIn()
          && validParticipants(resource.data.participants)
          && request.auth.uid in resource.data.participants
          // Participants and chatId are immutable; chat preview fields may be merged.
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.chatId == chatId;

      allow delete: if false;
    }

    // ── chats/{chatId}/messages/{msgId} (voice messages — Person 6) ──
    match /chats/{chatId}/messages/{msgId} {
      function chatDoc() {
        return get(/databases/$(database)/documents/chats/$(chatId));
      }

      allow read: if signedIn()
          && chatDoc().data.participants != null
          && validParticipants(chatDoc().data.participants)
          && request.auth.uid in chatDoc().data.participants;

      allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId
          && request.resource.data.receiverId != null
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && chatDoc().data.participants != null
          && request.auth.uid in chatDoc().data.participants
          && request.resource.data.receiverId in chatDoc().data.participants
          && request.resource.data.audioUrl != null
          && request.resource.data.audioUrl is string
          && request.resource.data.timestamp is number && request.resource.data.timestamp > 0
          && request.resource.data.uploadStatus in ["PENDING", "UPLOADING", "DONE", "FAILED"]
          && request.resource.data.messageStatus in ["SENT", "DELIVERED", "SEEN"]
          && request.resource.data.keys() == [
            "messageId", "chatId", "senderId", "receiverId",
            "audioUrl", "localPath", "durationMs", "fileSize",
            "timestamp", "uploadStatus", "messageStatus"
          ];

      allow update: if signedIn()
          && chatDoc().data.participants != null
          && validParticipants(chatDoc().data.participants)
          && request.auth.uid in chatDoc().data.participants
          // Only the receiver can mark a message as seen.
          && request.auth.uid == resource.data.receiverId
          // Only messageStatus may change; all other fields immutable.
          && request.resource.data.keys() == resource.data.keys().union(["messageStatus"])
          && request.resource.data.messageStatus == "SEEN"
          && resource.data.messageStatus != "SEEN";

      allow delete: if false;
    }

    // ── fcm_requests/{requestId} (push notifications — Person 6) ──
    match /fcm_requests/{requestId} {
      allow create: if signedIn()
          && isValidFcmRequest(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && senderIsChatParticipant(request.resource.data.chatId);

      allow read: if false;
      allow delete: if false;
      allow update: if false;
    }

    // ── sos_alerts/{uid}/sessions/{sessionId} (SOS session — Person 1 + Person 6) ──
    // EmergencySessionRepository writes sos_alerts/{userId}/sessions/{sessionId}
    // with fields: id, sessionId, userId, state, triggerType, startLat, startLng,
    // startTime, createdAt, updatedAt, resolvedAt, idempotencyKey, failureReason, message.
    match /sos_alerts/{uid}/sessions/{sessionId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && isValidTimeMs(request.resource.data.startTime)
          && (request.resource.data.startLat == null
              || isValidLatLng(request.resource.data.startLat, request.resource.data.startLng));

      allow update: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          // startTime and startLat/startLng are immutable once set.
          && request.resource.data.startTime == resource.data.startTime
          && request.resource.data.startLat == resource.data.startLat
          && request.resource.data.startLng == resource.data.startLng;

      allow delete: if false;
    }

    // ── sos_alerts/{uid}/sessions/{sessionId}/location_updates/{locationId} ──
    match /sos_alerts/{uid}/sessions/{sessionId}/location_updates/{locationId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) && isValidLocationUpdate(request.resource.data);

      allow update: if false;
      allow delete: if false;
    }

    // ── Safe Journey: journeys/{journeyId} (Person 3) ──
    match /journeys/{journeyId} {
      allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.journeyId == journeyId;

      allow read: if signedIn() && journeyOwner(journeyId);

      allow update: if signedIn() && journeyOwner(journeyId);

      allow delete: if signedIn() && journeyOwner(journeyId);

      match /locations/{locationId} {
        allow read, create, update, delete: if journeyOwner(journeyId);
      }

      match /checkins/{checkInId} {
        allow read, create, update, delete: if journeyOwner(journeyId);
      }

      match /deviations/{eventId} {
        allow read, create, update, delete: if journeyOwner(journeyId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if journeyOwner(journeyId);
      }
    }

    // ── Evidence: evidence/{evidenceId} (Person 4) ──
    // EvidenceUploadWorker writes evidence/{sosId} with {userId, sosId, timestamp, fileUrls, hashes}.
    match /evidence/{evidenceId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // ── Safe Walk legacy compatibility (Person 3 / Person 1) ──
    // JourneyEngine also maintains safe_walks/{userId} with legacy fields
    // (userId, startTime, isActive, journeyId, destinationName, expectedArrivalTime).
    match /safe_walks/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /locations/{locationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLocationUpdate(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── sos_logs/{logId} (SOS audit log — Person 6) ──
    match /sos_logs/{logId} {
      allow read: if signedIn() && resource.data != null && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && isValidLatLng(request.resource.data.latitude, request.resource.data.longitude)
          && isValidTimeMs(request.resource.data.timestamp)
          && request.resource.data.keys() == ["userId", "latitude", "longitude", "timestamp"];

      allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.keys() == resource.data.keys().union(["evidenceUrl"])
          && request.resource.data.evidenceUrl is string;

      allow delete: if false;
    }

    // ── Top-level collections retained from main (baseline, signed-in access) ──
    match /sessions/{sessionId} {
      allow read, write: if signedIn();
      match /{subcollection}/{docId} {
        allow read, write: if signedIn();
      }
    }

    match /locations/{locationId} {
      allow read, write: if signedIn();
      match /{subcollection}/{docId} {
        allow read, write: if signedIn();
      }
    }

    match /location_updates/{updateId} {
      allow read, write: if signedIn();
      match /{subcollection}/{docId} {
        allow read, write: if signedIn();
      }
    }

    // ── Server-side only (Cloud Functions). Clients cannot read or write. ────
    match /emergency_notifications/{notificationId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /emergency_acknowledgements/{ackId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /emergency_escalations/{escId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ── Default deny: nothing is accessible unless explicitly matched above. ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
